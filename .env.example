# 이 파일을 .env.local 로 복사해서 값을 채우면, 내 컴퓨터에서도 실제 백엔드로 실행할 수 있습니다.
#   cp .env.example .env.local
# Vercel에 배포할 때는 같은 이름으로 프로젝트의 Environment Variables 에 넣으세요.
# 모두 비워 두면 "데모 모드"로 동작합니다(한 브라우저의 여러 탭에서만 수업이 공유됨).

# Supabase 대시보드 → Project Settings → API (또는 Connect)
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...) 또는 예전 방식의 anon key. 브라우저에 공개되도록 설계된 값입니다.
# service_role / secret 키는 절대 넣지 마세요.
VITE_SUPABASE_ANON_KEY=

# 선택: 학생에게 주는 QR·참여 링크와 리포트 링크에 쓸 고정 주소. 예: https://내프로젝트.vercel.app
# 비워 두면 지금 접속한 주소를 씁니다.
VITE_PUBLIC_URL=
